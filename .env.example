PORT=4300
HOST=127.0.0.1
# Empty means no proxy trust. For a local nginx proxy: 127.0.0.1,::1
# Accepts explicit IPs only. Bind the app privately; nginx must replace forwarded headers.
TRUSTED_PROXY_IPS=
APP_ORIGIN=http://localhost:4300
FRAPPE_URL=https://erp-test.metaframer.net
# Generate independent random secrets: openssl rand -hex 32
SESSION_SECRET=
CATALOG_SHARED_SECRET=
# Separate Frappe user with read-only Item permission. Never expose with VITE_ prefix.
# Optional combined api_key:api_secret (provisioning helper writes this)
FRAPPE_CATALOG_TOKEN=
FRAPPE_CATALOG_API_KEY=
FRAPPE_CATALOG_API_SECRET=
CATALOG_ITEM_GROUP=Metaframer Demo
VITE_STOREFRONT_URL=http://localhost:4301

# Local-only /setup page operations; never enabled in production.
ENABLE_LOCAL_SETUP=0
LOCAL_STOREFRONT_URL=http://localhost:4301

# Local defaults. Pages uses remote bearer API; secrets never use VITE_ prefixes.
AUTH_MODE=cookie
API_ONLY=0
ALLOWED_ORIGINS=
VITE_BASE_PATH=/
VITE_ROUTER_MODE=browser
VITE_API_BASE_URL=
VITE_AUTH_MODE=cookie
